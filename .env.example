# Server
PORT=4000

# MongoDB connection (required)
# Examples: mongodb://localhost:27017/traineradda  or  mongodb+srv://user:pass@cluster.mongodb.net/traineradda
MONGODB_URI=mongodb://localhost:27017/traineradda

# Frontend origins (comma-separated for CORS)
# Use * to allow all origins (useful while deploying admin/site to new URLs)
# Example: CORS_ORIGINS=*
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-admin.vercel.app
CORS_ORIGINS=*

# JWT secret for admin auth (replace with a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin user (created on first run if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User

# Cloudinary - trainer profile photo upload (replace with your credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: upload folder for temp files (default: ./uploads)
# UPLOAD_DIR=./uploads
