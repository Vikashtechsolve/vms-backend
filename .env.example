# Server
PORT=4000

# MongoDB connection (required)
# Examples: mongodb://localhost:27017/traineradda  or  mongodb+srv://user:pass@cluster.mongodb.net/traineradda
MONGODB_URI=mongodb://localhost:27017/traineradda

# CORS: all origins are allowed by default (no env needed)

# JWT secret for admin auth (replace with a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin user (created on first run if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User

# Cloudinary - trainer profile photo upload (replace with your credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: upload folder for temp files (default: ./uploads)
# UPLOAD_DIR=./uploads

# Redis (required for campaign queue worker)
# Local:
REDIS_URL=redis://localhost:6379
# Railway: add Redis plugin, then reference on API + Worker services:
# REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_PRIVATE_URL=${{Redis.REDIS_PRIVATE_URL}}  (preferred for internal networking)

# Email layout auto-seed (API only, when database has zero layouts). Set false to disable.
# SEED_EMAIL_LAYOUT=false

# AWS SES (required for sending campaign emails)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=notifications@traineradda.com
SES_FROM_NAME=TrainerAdda

# Public URL for unsubscribe links and hosted email assets (logo images)
APP_PUBLIC_URL=http://localhost:4000

# Trainer Adda website URL (used in email header/footer links)
SITE_URL=https://traineradda.com

# Email logo (full brand mark — logo + text). Cloudinary default if unset.
# EMAIL_LOGO_URL=https://res.cloudinary.com/dc4gqqd35/image/upload/w_280,f_auto,q_auto/v1787319069/traineradda_bfnnbn.jpg
